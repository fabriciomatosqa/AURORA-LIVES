{
  "name": "@aurora-lives/desktop",
  "private": true,
  "version": "0.0.14",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "icons": "npm run test:brand && tauri icon src-tauri/icons/source.png",
    "pretauri": "npm run icons",
    "dev:native": "npm run tauri dev",
    "package:desktop": "npm run icons && tauri build",
    "test": "npm run test:brand && vitest run",
    "test:brand": "node scripts/verify-brand.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --apk --target aarch64 --ci",
    "android:preview": "vite --host 0.0.0.0 --port 1420"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.9.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "playwright-core": "^1.55.0"
  }
}
