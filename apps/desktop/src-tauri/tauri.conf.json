{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURORA LIVES",
  "version": "0.0.19",
  "identifier": "com.aurora.lives",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AURORA LIVES",
        "width": 1420,
        "height": 880,
        "minWidth": 640,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "backgroundColor": "#090F1F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://0.peerjs.com wss://0.peerjs.com http://127.0.0.1:1420 ws://127.0.0.1:1420 ws://localhost:1420; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AURORA LIVES — comunicação direta P2P",
    "category": "SocialNetworking"
  }
}
